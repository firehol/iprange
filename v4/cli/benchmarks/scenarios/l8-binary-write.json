{
 "schema": "iprange-bench-scenario-v1",
 "name": "l8-binary-write",
 "purpose": "Legacy binary write: --print-binary output read back and hashed across engines.",
 "fixtures": [
  {
   "path": "a.txt",
   "text": "10.0.0.1\n10.0.0.2\n10.0.0.3\n"
  },
  {
   "path": "b.txt",
   "text": "10.0.0.2\n10.0.0.3\n10.0.0.9\n"
  }
 ],
 "cli": [
  {
   "cli": {
    "args": [
     "--print-binary",
     "$WORK/a.txt",
     "$WORK/b.txt"
    ],
    "redirect_stdout": "merged.bin"
   },
   "compare": [
    "exit"
   ],
   "expect": {
    "exit": 0
   }
  },
  {
   "cli": {
    "args": [
     "$WORK/merged.bin"
    ]
   },
   "compare": [
    "exit",
    "stdout"
   ],
   "expect": {
    "exit": 0,
    "stdout": "10.0.0.1\n10.0.0.2/31\n10.0.0.9\n"
   },
   "expect_same_bytes": "merged.bin"
  }
 ]
}
