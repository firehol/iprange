{
 "schema": "iprange-bench-scenario-v1",
 "name": "l3-except-bogons",
 "purpose": "Legacy exclude-next: bogons removed from the merged set.",
 "fixtures": [
  {
   "path": "a.txt",
   "text": "10.0.0.1\n10.0.0.2\n10.0.0.3\n"
  },
  {
   "path": "bogon.txt",
   "text": "10.0.0.2/31\n"
  }
 ],
 "cli": [
  {
   "cli": {
    "args": [
     "$WORK/a.txt",
     "--except",
     "$WORK/bogon.txt"
    ]
   },
   "compare": [
    "exit",
    "stdout"
   ],
   "expect": {
    "exit": 0,
    "stdout": "10.0.0.1\n"
   }
  }
 ]
}
