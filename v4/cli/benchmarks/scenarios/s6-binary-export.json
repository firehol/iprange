{
  "schema": "iprange-bench-scenario-v1",
  "name": "s6-binary-export",
  "purpose": "Export one IPv4 feed as legacy binary. Both engines must write the same bytes.",
  "fixtures": [
    {"path": "feed.txt", "text": "192.0.2.0/30\n198.51.100.10\n"}
  ],
  "calls": [
    {
      "method": "iprange.v1.current.publish",
      "params": {
        "input": {
          "paths": ["$WORK/feed.txt"],
          "family": "ipv4",
          "fix_network": true,
          "default_prefix": 32,
          "dns": {"threads": 1, "silent": true},
          "expand_at_paths": false,
          "max_line_bytes": 1024,
          "max_expanded_paths": 4
        },
        "feed": "alpha",
        "value_tag": {"text": "feed"},
        "metadata": {"mode": "replace_utf8", "text": "alpha"},
        "destination": "$WORK/current.iprange",
        "publication_policy": "fail_if_exists",
        "immutable_feed_budget": {
          "max_heap_bytes": "16777216",
          "max_output_pages": "20000",
          "max_workspace_pages": "20000",
          "max_open_files": 3
        }
      },
      "compare": ["report.addresses"],
      "expect": {"report.addresses": "5"}
    },
    {
      "method": "iprange.v1.export",
      "params": {
        "source": {"path": "$WORK/current.iprange", "mode": "immutable"},
        "view": {"kind": "feed", "feed": "alpha"},
        "format": "legacy_binary",
        "destination": "$WORK/out.bin",
        "publication_policy": "fail_if_exists",
        "result_budget": {
          "max_rows": "1000",
          "max_output_bytes": "1048576",
          "max_open_files": 3
        }
      },
      "compare": ["format", "rows", "addresses", "bytes"],
      "expect": {"format": "legacy_binary", "rows": "2", "addresses": "5"},
      "expect_same_bytes": "out.bin"
    }
  ]
}
