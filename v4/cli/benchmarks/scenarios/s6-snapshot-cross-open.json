{
  "schema": "iprange-bench-scenario-v1",
  "name": "s6-snapshot-cross-open",
  "purpose": "Each engine snapshots the same feed. The other engine opens that snapshot and the counts must match.",
  "fixtures": [
    {"path": "feed.txt", "text": "192.0.2.0/30\n198.51.100.10\n"}
  ],
  "publish": ["snap.iprange"],
  "write": [
    {
      "method": "iprange.v1.current.publish",
      "params": {
        "input": {
          "paths": ["$WORK/feed.txt"],
          "family": "ipv4",
          "fix_network": true,
          "default_prefix": 32,
          "dns": {"threads": 1, "silent": true},
          "expand_at_paths": false,
          "max_line_bytes": 1024,
          "max_expanded_paths": 4
        },
        "feed": "alpha",
        "value_tag": {"text": "feed"},
        "metadata": {"mode": "replace_utf8", "text": "alpha"},
        "destination": "$WORK/current.iprange",
        "publication_policy": "fail_if_exists",
        "immutable_feed_budget": {
          "max_heap_bytes": "16777216",
          "max_output_pages": "20000",
          "max_workspace_pages": "20000",
          "max_open_files": 3
        }
      },
      "compare": ["report.addresses"],
      "expect": {"report.addresses": "5"}
    },
    {
      "method": "iprange.v1.snapshot",
      "params": {
        "source": {"path": "$WORK/current.iprange", "mode": "immutable"},
        "destination": "$WORK/snap.iprange",
        "publication_policy": "fail_if_exists",
        "snapshot_budget": {
          "max_heap_bytes": "16777216",
          "max_output_pages": "512",
          "max_open_files": 32
        }
      },
      "compare": ["publication.publication", "publication.destination_content"],
      "expect": {
        "publication.publication": "published",
        "publication.destination_content": "desired"
      }
    }
  ],
  "read": [
    {
      "method": "iprange.v1.database.info",
      "params": {
        "source": {"path": "$WORK/$PEER/snap.iprange", "mode": "immutable"}
      },
      "compare": [
        "info.address_family",
        "info.value_kind",
        "info.range_record_count",
        "info.active_feed_count"
      ],
      "expect": {
        "info.address_family": "ipv4",
        "info.value_kind": "membership",
        "info.range_record_count": "2",
        "info.active_feed_count": "1"
      }
    }
  ]
}
