{
 "schema": "iprange-bench-scenario-v1",
 "name": "l10-at-directory-arms",
 "purpose": "Legacy @directory arms: a file inside the directory expands, an empty directory answers the implementation's nonzero exit (src/iprange.c's no-valid-files error, both engines), and entry selection loads every regular file while non-regular entries are skipped (a subdirectory is not traversed; a non-ipset regular file contributes no addresses).",
 "fixtures": [
  {
   "path": "a.txt",
   "text": "10.0.0.1\n"
  },
  {
   "path": "scandir/a.txt",
   "text": "10.0.0.1\n"
  },
  {
   "path": "emptydir",
   "directory": true
  },
  {
   "path": "mixdir/only.txt",
   "text": "10.0.0.5\n"
  },
  {
   "path": "mixdir/notanipset.bin",
   "text": "\u0000\u0001garbage\n"
  },
  {
   "path": "mixdir/subdir/inner.txt",
   "text": "10.0.0.9\n"
  },
  {
   "path": "mixdir/valid-noext",
   "text": "10.0.0.7\n"
  }
 ],
 "cli": [
  {
   "cli": {
    "args": [
     "@$WORK/scandir"
    ]
   },
   "compare": [
    "exit",
    "stdout"
   ],
   "expect": {
    "exit": 0,
    "stdout": "10.0.0.1\n"
   }
  },
  {
   "cli": {
    "args": [
     "@$WORK/emptydir"
    ]
   },
   "compare": [
    "exit"
   ],
   "expect": {
    "exit": 1
   }
  },
  {
   "cli": {
    "args": [
     "@$WORK/mixdir"
    ]
   },
   "compare": [
    "exit",
    "stdout"
   ],
   "expect": {
    "exit": 0,
    "stdout": "10.0.0.5\n10.0.0.7\n"
   }
  }
 ]
}
