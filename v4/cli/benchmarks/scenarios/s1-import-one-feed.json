{
  "schema": "iprange-bench-scenario-v1",
  "name": "s1-import-one-feed",
  "purpose": "Import one unsorted IPv4 text feed into an immutable current-feed file and compare the committed counts.",
  "fixtures": [
    {
      "path": "feed.txt",
      "text": "198.51.100.10\n192.0.2.0/30\n192.0.2.2-192.0.2.6\n"
    }
  ],
  "calls": [
    {
      "method": "iprange.v1.current.publish",
      "params": {
        "input": {
          "paths": ["$WORK/feed.txt"],
          "family": "ipv4",
          "fix_network": true,
          "default_prefix": 32,
          "dns": {"threads": 1, "silent": true},
          "expand_at_paths": false,
          "max_line_bytes": 1024,
          "max_expanded_paths": 4
        },
        "feed": "alpha",
        "value_tag": {"text": "feed"},
        "metadata": {"mode": "replace_utf8", "text": "alpha"},
        "destination": "$WORK/current.iprange",
        "publication_policy": "fail_if_exists",
        "immutable_feed_budget": {
          "max_heap_bytes": "16777216",
          "max_output_pages": "20000",
          "max_workspace_pages": "20000",
          "max_open_files": 3
        }
      },
      "compare": [
        "report.input_record_count",
        "report.normalized_interval_count",
        "report.addresses"
      ]
    },
    {
      "method": "iprange.v1.database.info",
      "params": {
        "source": {"path": "$WORK/current.iprange", "mode": "immutable"}
      },
      "compare": [
        "info.address_family",
        "info.value_kind",
        "info.range_record_count",
        "info.active_feed_count"
      ]
    }
  ]
}
