{
  "schema": "iprange-bench-scenario-v1",
  "name": "s2-seven-day-refresh",
  "purpose": "Refresh first-seen across seven seeded days. The generator names each day's added, removed, and unchanged counts. Agreement between engines is not the proof.",
  "generate": [
    {
      "path": "day1.txt",
      "seed": 11,
      "count": 20,
      "span": 4,
      "space": 64,
      "expect_merged_addresses": 35
    },
    {
      "path": "day2.txt",
      "seed": 12,
      "count": 20,
      "span": 4,
      "space": 64,
      "expect_merged_addresses": 48
    },
    {
      "path": "day3.txt",
      "seed": 13,
      "count": 20,
      "span": 4,
      "space": 64,
      "expect_merged_addresses": 38
    },
    {
      "path": "day4.txt",
      "seed": 14,
      "count": 20,
      "span": 4,
      "space": 64,
      "expect_merged_addresses": 43
    },
    {
      "path": "day5.txt",
      "seed": 15,
      "count": 20,
      "span": 4,
      "space": 64,
      "expect_merged_addresses": 48
    },
    {
      "path": "day6.txt",
      "seed": 16,
      "count": 20,
      "span": 4,
      "space": 64,
      "expect_merged_addresses": 39
    },
    {
      "path": "day7.txt",
      "seed": 17,
      "count": 20,
      "span": 4,
      "space": 64,
      "expect_merged_addresses": 50
    }
  ],
  "calls": [
    {
      "method": "iprange.v1.current.publish",
      "params": {
        "input": {
          "paths": [
            "$WORK/day1.txt"
          ],
          "family": "ipv4",
          "fix_network": true,
          "default_prefix": 32,
          "dns": {
            "threads": 1,
            "silent": true
          },
          "expand_at_paths": false,
          "max_line_bytes": 1024,
          "max_expanded_paths": 4
        },
        "feed": "alpha",
        "value_tag": {
          "text": "feed"
        },
        "metadata": {
          "mode": "replace_utf8",
          "text": "d1"
        },
        "destination": "$WORK/day1.iprange",
        "publication_policy": "fail_if_exists",
        "immutable_feed_budget": {
          "max_heap_bytes": "16777216",
          "max_output_pages": "20000",
          "max_workspace_pages": "20000",
          "max_open_files": 3
        }
      },
      "compare": [
        "report.addresses"
      ],
      "expect": {
        "report.addresses": "35"
      }
    },
