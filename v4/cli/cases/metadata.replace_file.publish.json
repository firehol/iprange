{
 "schema": "iprange-cli-case-v1",
 "name": "metadata.replace_file.publish",
 "requires": "iprange.v1.current.publish",
 "fixtures": [
  {
   "path": "pub.ranges",
   "source": {
    "text": "192.0.2.1-192.0.2.2\n198.51.100.4\n"
   }
  },
  {
   "path": "meta.bin",
   "source": {
    "base64": ""
   }
  }
 ],
 "steps": [
  {
   "kind": "rpc",
   "actor": "producer",
   "method": "iprange.v1.current.publish",
   "params": {
    "input": {
     "paths": [
      "$WORK/pub.ranges"
     ],
     "family": "ipv4",
     "fix_network": false,
     "default_prefix": 32,
     "dns": {
      "threads": 1,
      "silent": true
     },
     "expand_at_paths": false,
     "max_line_bytes": 1024,
     "max_expanded_paths": 4
    },
    "feed": "rf",
    "value_tag": {
     "text": "rf"
    },
    "metadata": {
     "mode": "replace_file",
     "path": "$WORK/meta.bin"
    },
    "destination": "$WORK/rfpub.iprange",
    "publication_policy": "fail_if_exists",
    "immutable_feed_budget": {
     "max_heap_bytes": "16777216",
     "max_output_pages": "20000",
     "max_workspace_pages": "20000",
     "max_open_files": 3
    }
   },
   "expect_result": {
    "report": {
     "addresses": "3",
     "input_record_count": "2",
     "normalized_interval_count": "2"
    }
   }
  },
  {
   "kind": "rpc",
   "actor": "consumer",
   "method": "iprange.v1.database.metadata.get",
   "params": {
    "source": {
     "path": "$WORK/rfpub.iprange",
     "mode": "immutable"
    },
    "delivery": {
     "mode": "inline"
    }
   },
   "expect_result": {
    "present": true,
    "base64": ""
   }
  }
 ]
}
