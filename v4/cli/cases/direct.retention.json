{
  "schema": "iprange-cli-case-v1",
  "name": "direct.retention",
  "requires": "iprange.v1.retention.first_seen.refresh",
  "fixtures": [
    {"path": "membership.iprange", "source": {"generator": "v4_fixture", "seed": 1}},
    {"path": "first_seen.csv",
     "source": {"text": "from,to,value\n192.0.2.0,192.0.2.19,10\n198.51.100.0,198.51.100.9,20\n"}},
    {"path": "last_seen.csv",
     "source": {"text": "from,to,value\n192.0.2.0,192.0.2.19,1000\n198.51.100.0,198.51.100.9,10\n"}}
  ],
  "steps": [
    {"kind": "rpc", "method": "iprange.v1.database.create",
     "params": {"path": "$WORK/first_seen.iprange", "family": "ipv4", "value_kind": "direct",
                "structure_kind": "none", "value_tag": {"text": "first_seen"},
                "reader_capacity": 8},
     "expect_result": {
       "address_family": "ipv4", "value_kind": "direct", "structure_kind": "none",
       "value_tag": {"hex": "66697273745f7365656e"},
       "database_id": {"$ignore": true}, "commit_nonce": {"$ignore": true},
       "sidecar_id": {"$ignore": true}, "main_basename": "first_seen.iprange",
       "reader_capacity": 8, "state": "created", "residue_possible": false,
       "housekeeping": {"artifacts": []}, "visible_housekeeping": [],
       "directory_identity": {"$ignore": true}, "main_identity": {"$ignore": true},
       "sidecar_identity": {"$ignore": true}
     }},
    {"kind": "rpc", "method": "iprange.v1.direct.replace",
     "params": {"path": "$WORK/first_seen.iprange",
                "input": {"path": "$WORK/first_seen.csv", "max_line_bytes": 1024},
                "metadata": {"mode": "replace_utf8", "text": "first-seen-data"},
                "writer_budget": {"max_heap_bytes": "16777216", "max_private_pages": "20000",
                                  "max_growth_pages": "20000", "max_open_files": 4}},
     "expect_result": {
       "report": {
         "workflow": "direct_replacement", "logical_change": "changed",
         "input_record_count": "2", "input_normalized_interval_count": "2",
         "before_range_record_count": "0", "after_range_record_count": "2",
         "input_addresses": "30", "before_addresses": "0", "after_addresses": "30",
         "unchanged_value_addresses": "0", "changed_value_addresses": "0",
         "added_addresses": "30", "removed_addresses": "0",
         "source_feed_count": "0", "matched_feed_count": "0", "created_feed_count": "0",
         "source_distinct_membership_count": "0", "translated_membership_count": "0"
       },
       "metadata_logical_change": "changed",
       "commit": {"attempted_database_id": {"$ignore": true},
                  "directory_identity": {"$ignore": true},
                  "main_identity": {"$ignore": true},
                  "attempted_transaction_id": "2",
                  "attempted_commit_nonce": {"$ignore": true},
                  "durability": "committed", "cleanup": {}, "coordination_cleanup": {}},
       "writer_close": {"cleanup": {}, "coordination_cleanup": {}, "outcome": "closed"}
     }},
    {"kind": "rpc", "method": "iprange.v1.retention.first_seen.refresh",
     "params": {"path": "$WORK/first_seen.iprange",
                "current": {"source": {"path": "$WORK/membership.iprange", "mode": "immutable"},
                            "feed": "alpha"},
                "refresh_value": 123456,
                "removals_output": {"path": "$WORK/removals.jsonl",
                                    "publication_policy": "fail_if_exists",
                                    "result_budget": {"max_rows": "64",
                                                      "max_output_bytes": "65536",
                                                      "max_open_files": 3}},
                "metadata": {"mode": "keep"},
                "writer_budget": {"max_heap_bytes": "16777216", "max_private_pages": "20000",
                                  "max_growth_pages": "20000", "max_open_files": 4}},
     "expect_result": {
       "report": {
         "workflow": "first_seen_refresh", "logical_change": "changed",
         "input_record_count": "2", "input_normalized_interval_count": "2",
         "before_range_record_count": "2", "after_range_record_count": "3",
         "input_addresses": "31", "before_addresses": "30", "after_addresses": "31",
         "unchanged_value_addresses": "20", "changed_value_addresses": "0",
         "added_addresses": "11", "removed_addresses": "10",
         "source_feed_count": "0", "matched_feed_count": "0", "created_feed_count": "0",
         "source_distinct_membership_count": "0", "translated_membership_count": "0"
       },
       "metadata_logical_change": "unchanged",
       "commit": {"attempted_database_id": {"$ignore": true},
                  "directory_identity": {"$ignore": true},
                  "main_identity": {"$ignore": true},
                  "attempted_transaction_id": "3",
                  "attempted_commit_nonce": {"$ignore": true},
                  "durability": "committed", "cleanup": {}, "coordination_cleanup": {}},
       "removals": {"publication": {"publication": "published",
                                    "destination_content": "created"},
                    "output": {"path": {"$ignore": true}, "bytes": "97", "rows": "1",
                               "sha256": "0aaaef9d7a88b7f42fb6f53c8cd45f7842ba84b730d01f28ae67298c22751ecd"}},
       "writer_close": {"cleanup": {}, "coordination_cleanup": {}, "outcome": "closed"}
     },
     "assert_files": [
       {"path": "removals.jsonl", "sha256": "0aaaef9d7a88b7f42fb6f53c8cd45f7842ba84b730d01f28ae67298c22751ecd"}
     ]},
    {"kind": "rpc", "method": "iprange.v1.database.create",
     "params": {"path": "$WORK/last_seen.iprange", "family": "ipv4", "value_kind": "direct",
                "structure_kind": "none", "value_tag": {"text": "last_seen"},
                "reader_capacity": 8},
     "expect_result": {
       "address_family": "ipv4", "value_kind": "direct", "structure_kind": "none",
       "value_tag": {"hex": "6c6173745f7365656e"},
       "database_id": {"$ignore": true}, "commit_nonce": {"$ignore": true},
       "sidecar_id": {"$ignore": true}, "main_basename": "last_seen.iprange",
       "reader_capacity": 8, "state": "created", "residue_possible": false,
       "housekeeping": {"artifacts": []}, "visible_housekeeping": [],
       "directory_identity": {"$ignore": true}, "main_identity": {"$ignore": true},
       "sidecar_identity": {"$ignore": true}
     }},
    {"kind": "rpc", "method": "iprange.v1.direct.replace",
     "params": {"path": "$WORK/last_seen.iprange",
                "input": {"path": "$WORK/last_seen.csv", "max_line_bytes": 1024},
                "metadata": {"mode": "keep"},
                "writer_budget": {"max_heap_bytes": "16777216", "max_private_pages": "20000",
                                  "max_growth_pages": "20000", "max_open_files": 4}},
     "expect_result": {
       "report": {
         "workflow": "direct_replacement", "logical_change": "changed",
         "input_record_count": "2", "input_normalized_interval_count": "2",
         "before_range_record_count": "0", "after_range_record_count": "2",
         "input_addresses": "30", "before_addresses": "0", "after_addresses": "30",
         "unchanged_value_addresses": "0", "changed_value_addresses": "0",
         "added_addresses": "30", "removed_addresses": "0",
         "source_feed_count": "0", "matched_feed_count": "0", "created_feed_count": "0",
         "source_distinct_membership_count": "0", "translated_membership_count": "0"
       },
       "metadata_logical_change": "unchanged",
       "commit": {"attempted_database_id": {"$ignore": true},
                  "directory_identity": {"$ignore": true},
                  "main_identity": {"$ignore": true},
                  "attempted_transaction_id": "2",
                  "attempted_commit_nonce": {"$ignore": true},
                  "durability": "committed", "cleanup": {}, "coordination_cleanup": {}},
       "writer_close": {"cleanup": {}, "coordination_cleanup": {}, "outcome": "closed"}
     }},
    {"kind": "rpc", "method": "iprange.v1.retention.last_seen.refresh",
     "params": {"path": "$WORK/last_seen.iprange",
                "current": {"source": {"path": "$WORK/membership.iprange", "mode": "immutable"},
                            "feed": "alpha"},
                "refresh_value": 100, "cutoff": 50,
                "metadata": {"mode": "keep"},
                "writer_budget": {"max_heap_bytes": "16777216", "max_private_pages": "20000",
                                  "max_growth_pages": "20000", "max_open_files": 4}},
     "expect_result": {
       "report": {
         "workflow": "last_seen_refresh", "logical_change": "changed",
         "input_record_count": "2", "input_normalized_interval_count": "2",
         "before_range_record_count": "2", "after_range_record_count": "3",
         "input_addresses": "31", "before_addresses": "30", "after_addresses": "31",
         "unchanged_value_addresses": "20", "changed_value_addresses": "0",
         "added_addresses": "11", "removed_addresses": "10",
         "source_feed_count": "0", "matched_feed_count": "0", "created_feed_count": "0",
         "source_distinct_membership_count": "0", "translated_membership_count": "0"
       },
       "metadata_logical_change": "unchanged",
       "commit": {"attempted_database_id": {"$ignore": true},
                  "directory_identity": {"$ignore": true},
                  "main_identity": {"$ignore": true},
                  "attempted_transaction_id": "3",
                  "attempted_commit_nonce": {"$ignore": true},
                  "durability": "committed", "cleanup": {}, "coordination_cleanup": {}},
       "writer_close": {"cleanup": {}, "coordination_cleanup": {}, "outcome": "closed"}
     }},
    {"kind": "rpc", "method": "iprange.v1.database.reclaim",
     "params": {"path": "$WORK/last_seen.iprange", "max_transactions": "64",
                "max_pages": "64",
                "writer_budget": {"max_heap_bytes": "16777216", "max_private_pages": "20000",
                                  "max_growth_pages": "20000", "max_open_files": 4}},
     "expect_result": {
       "reclamation": {"kind": "commit", "transaction_count": "1", "page_count": "1",
                       "commit": {"attempted_database_id": {"$ignore": true},
                                  "directory_identity": {"$ignore": true},
                                  "main_identity": {"$ignore": true},
                                  "attempted_transaction_id": "4",
                                  "attempted_commit_nonce": {"$ignore": true},
                                  "durability": "committed",
                                  "cleanup": {}, "coordination_cleanup": {}}},
       "writer_close": {"cleanup": {}, "coordination_cleanup": {}, "outcome": "closed"}
     }}
  ]
}
