{
 "schema": "iprange-cli-case-v1",
 "name": "metadata.replace_file.replace",
 "requires": "iprange.v1.database.metadata.replace",
 "fixtures": [
  {
   "path": "data.csv",
   "source": {
    "text": "from,to,value\n192.0.2.10,192.0.2.14,10\n198.51.100.30,198.51.100.31,30\n"
   }
  },
  {
   "path": "meta.bin",
   "source": {
    "base64": ""
   }
  }
 ],
 "steps": [
  {
   "kind": "rpc",
   "actor": "producer",
   "method": "iprange.v1.database.create",
   "params": {
    "path": "$WORK/rfm.iprange",
    "family": "ipv4",
    "value_kind": "direct",
    "structure_kind": "none",
    "value_tag": {
     "text": "rfm"
    },
    "reader_capacity": 8
   },
   "expect_result": {
    "address_family": "ipv4",
    "value_kind": "direct",
    "structure_kind": "none",
    "main_basename": "rfm.iprange",
    "reader_capacity": 8,
    "state": "created",
    "residue_possible": false,
    "housekeeping": {
     "artifacts": []
    },
    "visible_housekeeping": [],
    "value_tag": {
     "hex": "72666d"
    },
    "database_id": {
     "$ignore": true
    },
    "commit_nonce": {
     "$ignore": true
    },
    "sidecar_id": {
     "$ignore": true
    },
    "directory_identity": {
     "$ignore": true
    },
    "main_identity": {
     "$ignore": true
    },
    "sidecar_identity": {
     "$ignore": true
    }
   }
  },
  {
   "kind": "rpc",
   "actor": "consumer",
   "method": "iprange.v1.database.metadata.get",
   "params": {
    "source": {
     "path": "$WORK/rfm.iprange",
     "mode": "live"
    },
    "delivery": {
     "mode": "inline"
    }
   },
   "expect_result": {
    "present": false
   }
  },
  {
   "kind": "rpc",
   "actor": "producer",
   "method": "iprange.v1.database.metadata.replace",
   "params": {
    "path": "$WORK/rfm.iprange",
    "metadata": {
     "mode": "replace_file",
     "path": "$WORK/meta.bin"
    },
    "writer_budget": {
     "max_heap_bytes": "16777216",
     "max_private_pages": "20000",
     "max_growth_pages": "20000",
     "max_open_files": 4
    }
   },
   "expect_result": {
    "logical_change": "changed",
    "commit": {
     "durability": "committed",
     "attempted_database_id": {
      "$ignore": true
     },
     "attempted_transaction_id": {
      "$ignore": true
     },
     "attempted_commit_nonce": {
      "$ignore": true
     },
     "directory_identity": {
      "$ignore": true
     },
     "main_identity": {
      "$ignore": true
     },
     "cleanup": {
      "$ignore": true
     },
     "coordination_cleanup": {
      "$ignore": true
     }
    }
   }
  },
  {
   "kind": "rpc",
   "actor": "consumer",
   "method": "iprange.v1.database.metadata.get",
   "params": {
    "source": {
     "path": "$WORK/rfm.iprange",
     "mode": "live"
    },
    "delivery": {
     "mode": "inline"
    }
   },
   "expect_result": {
    "present": true,
    "base64": ""
   }
  },
  {
   "kind": "rpc",
   "actor": "producer",
   "method": "iprange.v1.database.metadata.replace",
   "params": {
    "path": "$WORK/rfm.iprange",
    "metadata": {
     "mode": "replace_file",
     "path": "$WORK/meta.bin"
    },
    "writer_budget": {
     "max_heap_bytes": "16777216",
     "max_private_pages": "20000",
     "max_growth_pages": "20000",
     "max_open_files": 4
    }
   },
   "expect_result": {
    "logical_change": "changed"
   }
  }
 ]
}
