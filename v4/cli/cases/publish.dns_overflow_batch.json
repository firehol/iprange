{
 "schema": "iprange-cli-case-v1",
 "name": "publish.dns_overflow_batch",
 "requires": "iprange.v1.current.publish",
 "fixtures": [
  {
   "path": "many-hosts.txt",
   "source": {
    "base64": ""
   }
  }
 ],
 "steps": [
  {
   "kind": "rpc",
   "actor": "producer",
   "method": "iprange.v1.current.publish",
   "params": {
    "input": {
     "paths": [
      "$WORK/many-hosts.txt"
     ],
     "family": "ipv4",
     "fix_network": false,
     "default_prefix": 32,
     "dns": {
      "threads": 4,
      "silent": true
     },
     "expand_at_paths": false,
     "max_line_bytes": 1024,
     "max_expanded_paths": 4
    },
    "feed": "dnsoverflow",
    "value_tag": {
     "text": "dnsoverflow"
    },
    "metadata": {
     "mode": "replace_utf8",
     "text": "dns-overflow"
    },
    "destination": "$WORK/dns-overflow.iprange",
    "publication_policy": "fail_if_exists",
    "immutable_feed_budget": {
     "max_heap_bytes": "16777216",
     "max_output_pages": "20000",
     "max_workspace_pages": "20000",
     "max_open_files": 3
    }
   },
   "expect_result": {
    "report": {
     "input_record_count": {
      "$ignore": true
     },
     "normalized_interval_count": {
      "$ignore": true
     },
     "addresses": {
      "$ignore": true
     }
    },
    "publication": {
     "$ignore": true
    }
   }
  }
 ]
}
